# Copy this file to .env and fill in real values. .env is gitignored and never committed.

# --- Ports ---
BACKEND_PORT=8007
FRONTEND_PORT=3007
INTEGRATION_PORT=8090
ODOO_PORT=8069
POSTGRES_PORT=5432

# --- Django backend ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3007
PRIMEPROJECTS_SERVICE_TOKEN=replace-with-a-long-random-string

# --- PrimeProjects application database (Postgres) ---
POSTGRES_DB=primeprojects
POSTGRES_USER=primeprojects
POSTGRES_PASSWORD=replace-with-a-strong-password

# --- Odoo ---
# The database name you create in the Odoo database manager (must match).
ODOO_DB=primeprojects
# The admin email/password you set when creating that Odoo database.
ODOO_ADMIN_LOGIN=replace-with-your-odoo-admin-email
ODOO_ADMIN_PASSWORD=replace-with-your-odoo-admin-password
# Internal Postgres credentials used only by the Odoo container (not exposed to host).
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=replace-with-a-strong-password

# --- Invoice sync queue worker ---
QUEUE_POLL_MS=5000
# Only for local dev/testing when an invoice has no real customer-to-Odoo-partner mapping yet.
DEFAULT_ODOO_PARTNER_ID=

# --- Frontend demo login button ---
# Must match a real Django user (see: python manage.py createsuperuser).
# Leave blank to hide the "Demo login" button entirely.
DEMO_USERNAME=
DEMO_PASSWORD=
